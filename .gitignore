# Ignore everything by default
*

# Whitelist Prometheus-Nexus Project Files
!/prometheus_robotics/
!/prometheus_robotics/**
!/dashboard.py
!/Dockerfile
!/docker-compose.yml
!/requirements.txt
!/README.md
!/check_genai.py
!/.gitignore

# Explicitly ignore secrets and temporary files (redundant but safe)
.env
.venv/
__pycache__/
*.pyc
*.log
