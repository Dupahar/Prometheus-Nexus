# Ignore everything in root
/*

# Whitelist Prometheus-Nexus Project Files
!/prometheus_robotics/
!/dashboard.py
!/Dockerfile
!/docker-compose.yml
!/requirements.txt
!/README.md
!/check_genai.py
!/.gitignore

# Explicitly ignore keys/envs if they somehow get included
.env
.venv/
__pycache__/
*.pyc
*.log
